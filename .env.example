# Composio project API key for the website backend.
# Get it from Dashboard -> Settings -> Project Settings -> API Keys.
COMPOSIO_API_KEY=ak_your_project_key

# Random secret used to sign the local auth session cookie.
# Generate one with: openssl rand -hex 32
AUTH_SECRET=replace_with_a_random_32_character_secret

# Optional dedicated key for encrypting stored LLM API keys.
# If omitted, AUTH_SECRET is used. Generate one with: openssl rand -hex 32
# LLM_ENCRYPTION_KEY=replace_with_a_random_32_character_secret

# Optional. Used to build OAuth callback links when the request origin is not
# the public origin (for example behind a proxy or tunnel).
# NEXT_PUBLIC_APP_URL=https://your-domain.example

# Optional shared AI provider used when a user does not supply their own API key.
# SHARED_LLM_PROVIDER=openai
# SHARED_LLM_MODEL=gpt-4o-mini
# SHARED_LLM_API_KEY=sk_your_shared_key
# SHARED_LLM_BASE_URL=
# SHARED_LLM_DAILY_LIMIT=20

