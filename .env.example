# Composio project API key for the website backend.
# Get it from Dashboard -> Settings -> Project Settings -> API Keys.
COMPOSIO_API_KEY=ak_your_project_key

# Random secret used to sign the local auth session cookie.
# Generate one with: openssl rand -hex 32
AUTH_SECRET=replace_with_a_random_32_character_secret

# Optional. Used to build OAuth callback links when the request origin is not
# the public origin (for example behind a proxy or tunnel).
# NEXT_PUBLIC_APP_URL=https://your-domain.example

# Optional local AI model. Used by the AI idea search feature.
# LOCAL_LLM_URL=http://127.0.0.1:11434
# LOCAL_LLM_MODEL=qwen2.5:0.5b
# LOCAL_LLM_TIMEOUT_MS=60000
